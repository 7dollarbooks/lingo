<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed to hold a standby request for the cellular network (so LlmClient can bind
         cloud calls to it when away from home Wi-Fi) — without it, ConnectivityManager
         .requestNetwork() for a specific transport throws a SecurityException. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Needed (together with ACCESS_FINE_LOCATION) to read the real Wi-Fi SSID — without
         it, WifiInfo.getSsid() is redacted to "<unknown ssid>" even with location granted. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Wi-Fi Direct to the glasses for the full-photo import. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Needed to read the current Wi-Fi SSID, so Lingo can tell home Wi-Fi apart from
         other networks and route cloud calls over mobile data otherwise. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Needed to (un)mute the stream that carries the speech-recognizer beep. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Glasses GATT held in-session (assistant / vision) — type union with microphone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:name=".LiveTranslateApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveTranslateHeadphones">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LiveTranslateHeadphones">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TranslationForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />

        <receiver
            android:name=".GadgetbridgeBleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="nodomain.freeyourgadget.gadgetbridge.ble_api.events.CHARACTERISTIC_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
